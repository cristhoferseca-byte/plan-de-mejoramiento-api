# ============================================================
#  BudgetFlow — Variables de entorno
#  Renombra a .env y completa los valores
# ============================================================

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password
DB_NAME=budgetflow

# Servidor
PORT=3000

# Frontend (CORS)
FRONTEND_URL=http://localhost:5173

# ─── CORREO ─────────────────────────────────────────────────
# Opción A: Gmail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=tucorreo@gmail.com
MAIL_PASS=xxxx_xxxx_xxxx_xxxx   # App Password (no tu contraseña normal)

# Opción B: Outlook / Hotmail
# MAIL_HOST=smtp.office365.com
# MAIL_PORT=587
# MAIL_SECURE=false
# MAIL_USER=tucorreo@outlook.com
# MAIL_PASS=tu_password

# Opción C: Mailtrap (pruebas locales — inbox falso)
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_SECURE=false
# MAIL_USER=tu_user_mailtrap
# MAIL_PASS=tu_pass_mailtrap
